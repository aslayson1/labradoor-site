{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/api/redaction-token-verification",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/api/redaction-session",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/admin/video-redaction/:path*",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://*.modal.run; media-src 'self' blob:; img-src 'self' data: blob:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/blog",
      "destination": "https://www.withmoment.io/publication/labradoor/blog"
    },
    {
      "source": "/blog/:path*",
      "destination": "https://www.withmoment.io/publication/labradoor/blog/:path*"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://www.withmoment.io/publication/labradoor/sitemap.xml"
    },
    {
      "source": "/_next/static/:path*",
      "destination": "https://www.withmoment.io/_next/static/:path*"
    },
    {
      "source": "/_next/image",
      "destination": "https://www.withmoment.io/_next/image"
    },
    {
      "source": "/labradoor-logo.png",
      "destination": "https://www.withmoment.io/labradoor-logo.png"
    },
    {
      "source": "/api/content/track",
      "destination": "https://www.withmoment.io/api/content/track"
    }
  ]
}
